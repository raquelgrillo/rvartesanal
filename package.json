{
  "name": "rvartesanal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de encomendas da RV Artesanal (Cloudflare Pages + Functions + D1).",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:init:local": "wrangler d1 execute rvartesanal --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute rvartesanal --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
